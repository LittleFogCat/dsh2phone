    <string name="steps_title">如何开始</string>
    <string name="step_1">在电脑上打开 DSH Desktop</string>
    <string name="step_2">点击左下角账号菜单 → “配对手机”</string>
    <string name="step_3">用本 App 扫描弹出的二维码</string>

    <string name="security_title">安全说明</string>
