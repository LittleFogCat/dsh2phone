<?xml version="1.0" encoding="utf-8"?>
<!-- 正式包只允许 HTTPS；IP 直连时证书不匹配由 App 内显式开关处理，不放开明文。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
