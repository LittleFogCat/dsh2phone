# ============================================================================
# dsh2phone — configuration template
#
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#   then fill in the values below. .env itself is git-ignored.
#
# Every entry point reads this file through shared/env.mjs; a variable already
# present in the real environment wins over the file.
# ============================================================================

# ---- public relay entry -----------------------------------------------------
# Control-plane WSS endpoint the PC tunnel dials out to.
RELAY_URL=wss://your-domain.example/dsh-tunnel
# Public pairing page; the QR code content is this URL + "?code=...".
PUBLIC_PAIR_URL=https://your-domain.example/dsh-pair

# Shared tunnel secret. Must match the relay's DSH_TUNNEL_KEY (server .env).
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
DSH_TUNNEL_KEY=replace-with-48-hex-chars

# Set to 1 only when the relay is addressed by IP while its certificate is
# issued for a domain name (emergency fallback; disables TLS verification).
DSH2PHONE_ALLOW_INVALID_CERT=0

# ---- local DSH Desktop ------------------------------------------------------
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=43120
# Host header DSH sees; also the authority used to mint the DSH cookie.
# Keep it loopback even when the public entry is a domain or a server IP.
DSH_AUTHORITY=127.0.0.1:43120
# Lifetime (days) of the minted DSH browser cookie.
DSH2PHONE_TTL_DAYS=30
# Defaults to ~/.dsh/.credentials.yaml; set only for a non-default DSH_HOME.
DSH_CREDENTIALS_FILE=
# DSH Desktop install dir (the plugin resolves @deepseek-ai/* from here).
DSH_APP_DIR=/path/to/DSH Desktop/resources/app

# ---- local paths ------------------------------------------------------------
# Absolute path of this checkout.
DSH2PHONE_HOME=/path/to/dsh2phone
# Optional: read the tunnel key from a file instead of DSH_TUNNEL_KEY.
DSH2PHONE_KEY_FILE=

# ---- relay runtime (docker-compose supplies these in production) ------------
RELAY_DATA_PORT=3200
RELAY_CONTROL_PORT=3201
RELAY_STATE_DIR=
RELAY_PUBLIC_PREFIX=/dsh

# ---- deployment facts (used by the nginx templates / docs only) -------------
DSH2PHONE_DOMAIN=your-domain.example
DSH2PHONE_SERVER_IP=203.0.113.10
DSH2PHONE_SSH_USER=root
DSH2PHONE_SSH_KEY=~/.ssh/id_ed25519
