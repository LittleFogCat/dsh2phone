# ============================================================================
# dsh2phone — 入库红线：下面的路径含有密钥、凭据、机器相关信息或运行时状态，
# 一律不提交。新增文件前先想清楚：它会不会泄露域名/服务器 IP/密钥/设备身份。
# ============================================================================

# ---- 依赖与缓存 ------------------------------------------------------------
node_modules/
.npm-cache/

# ---- 私有配置（真实值只在 .env，模板是 .env.example）----------------------
.env
.env.*
!.env.example
# 开机自启脚本含本机绝对路径；模板见 tunnel/autostart.vbs.example
tunnel/autostart.vbs

# ---- 密钥与证书 ------------------------------------------------------------
*.key
*.pem
*.p12
*.jks
*.keystore
deploy/tls/
deploy/server/tunnel.key

# ---- 运行时状态与凭据 ------------------------------------------------------
# curl/浏览器 cookie jar（含有效的 DSH cookie 与设备 cookie）
.e2e-jar.txt
.gui-cookie.txt
.dump_config.txt
.e2e-state/
.plugin-smoke-state/
.gate-repro-state/
.lan-check-state/
# relay 设备注册表（设备 id / UA / IP）
**/state/devices.json
deploy/server/data/dsh-relay/state/
# tunnel 局域网直连边缘的自签证书（*.pem 已全局忽略，目录兜底）
tunnel/state/

# ---- Android 构建缓存与本地产物 -------------------------------------------
# 本机下载的 Gradle 发行版 / 构建机专用 Android 目录（含 debug.keystore）
.tools/
.android-home/
.gradle-home/
.mobile-e2e-state/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/keystore/
mobile/android/keystore.properties
mobile/android/.cxx/
mobile/android/captures/
# 交付用 APK / 本地 e2e 截图
mobile/dist/

# ---- 日志与诊断输出 --------------------------------------------------------
*.log
deploy/diag-firewall.out.txt
deploy/*.out.txt

# ---- 编辑器 / 系统 ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 临时诊断脚本（用完即删，不入库） --------------------------------------
.perf-*.mjs
.tmp-*

